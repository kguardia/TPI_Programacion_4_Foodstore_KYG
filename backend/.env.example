# PostgreSQL (recomendado). Para desarrollo local con SQLite: sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/foodstore_db

# Generala con: python -c "import secrets; print(secrets.token_hex(32))" (mínimo 32 caracteres)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173
